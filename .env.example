# Single template for both Docker Compose and local backend development.
# Copy this file to .env and fill in production values. Never commit .env.
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shop
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://shop:change-me@db:5432/shop

SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8080

ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+79990000000
ADMIN_PASSWORD=ChangeMe_Admin123!
ADMIN_FULL_NAME=Store Administrator

FRONTEND_URL=http://localhost:8080
RESEND_API_KEY=
EMAIL_FROM=
PASSWORD_RESET_EXPIRE_MINUTES=15
